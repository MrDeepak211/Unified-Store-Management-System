SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Use a random secret of at least 32 characters; keep it private.\nORDER_TRACKING_SECRET=replace-with-a-random-secret-at-least-32-characters\n