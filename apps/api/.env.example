API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
DATABASE_URL=postgresql://usms:usms_dev_only@localhost:5432/usms
DB_POOL_MAX=10
